# Les secrets d'une instance ne vivent dans aucun repo (RFC-007 D7.4).
.env
# La part de la trempe qu'on ne publie pas sans désigner ce qu'elle tait.
*.local.txt
# Une coupe est un dérivé : régénérée, jamais commitée (RFC-007 D7.1).
dist/
# Le dojo d'une instance : ses harness (un repo chacun, D9.1), son journal,
# ses comptes (R12.2), ses verdicts — rien de tout cela n'est le produit.
dojo/harness/
dojo/journal/*
!dojo/journal/.gitkeep
# Le dossier des comptes doit exister avant le premier `up` : monté absent,
# Docker le crée à root et le service ne peut pas y ouvrir sa base.
dojo/comptes/*
!dojo/comptes/.gitkeep
*.sqlite3
*.sqlite3-journal
# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

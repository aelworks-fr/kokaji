# Les secrets d'une instance — jamais dans aucun repo (RFC-007 D7.4).
# Copier en `.env`, renseigner, ne jamais commiter.

# La clé d'administration de la passerelle. À tirer au sort :
#   openssl rand -hex 24
LITELLM_MASTER_KEY=sk-remplacer-moi

# Le moteur. Exemple avec IONOS AI Model Hub — remplaçable par tout
# fournisseur compatible OpenAI dans litellm-config.yaml.
IONOS_API_KEY=remplacer-moi
IONOS_API_BASE=https://openai.inference.de-txl.ionos.com/v1

# Le mot de passe de la base de la passerelle.
POSTGRES_PASSWORD=remplacer-moi

# Le domaine servi par le proxy. `localhost` pour un poste de travail.
DOMAINE=localhost

# Les secrets et les choix d'une instance — copier en `dojo/.env`, jamais
# versionné (SPECS §12, R12.5). Rien ici n'est connu du produit.

# --- Base de la passerelle ---------------------------------------------------
POSTGRES_PASSWORD=change-moi

# --- Passerelle et chat ------------------------------------------------------
# À tirer au sort, chacun :  openssl rand -hex 32
LITELLM_MASTER_KEY=sk-change-moi
LITELLM_SALT_KEY=change-moi
WEBUI_SECRET_KEY=change-moi
# Le secret partagé entre le chat et Kokaji (RFC-005 §3.3) :
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
KOKAJI_CHAT_SECRET=change-moi

# Une clé virtuelle par usage, révocable (R3.4). Créées après le premier
# démarrage — voir README.md, « Les clés ». En attendant, le placeholder tient.
DOJO_CLE_CHAT=sk-a-creer
DOJO_CLE_BANC=sk-a-creer
# La clé d'API d'un compte administrateur du chat (Paramètres → Compte → clé
# d'API). Sans elle, Kokaji n'administre aucun compte du chat, et le dit.
DOJO_CLE_CHAT_ADMIN=

# --- Moteurs -----------------------------------------------------------------
# Le seul trafic sortant d'une instance. Quel moteur incarne quel kata se
# choisit dans litellm/moteurs.yaml.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_API_BASE=

# --- Harness et coupes -------------------------------------------------------
# Le dossier **des** harness servis — un sous-dossier par harness, chacun son
# repo git (RFC-009 D9.1). `dojo/harness/` n'est pas versionné ici.
KOKAJI_HARNESS_HOST=./harness
# Le harness que tout compte peut copier pour démarrer (RFC-004 §7).
KOKAJI_HARNESS_EXEMPLE=atelier
# Les coupes forgées — la sortie de `kokaji forge`, jamais versionnée (D9.1).
KOKAJI_COUPES_HOST=./dist/coupes
KOKAJI_CIBLE_DEFAUT=sobre
# Les modèles servis sans coupe : le chat en appelle un pour ses titres.
KOKAJI_MODELES_NUS=banc/persona

# --- Veille et vigie (§7, §8) ------------------------------------------------
KOKAJI_REPOS=120          # silence après quoi une session est close
KOKAJI_BOUCLE=30          # intervalle de la veille
KOKAJI_VIGIE_BOUCLE=300   # intervalle de la vigie
# La veille écrit dans le corpus monté : elle prend l'identité qui le possède.
KOKAJI_UID=1000
KOKAJI_GID=1000

# --- Exposition --------------------------------------------------------------
# Par défaut : loopback seule, sans proxy. Les ports, si d'autres les tiennent.
DOJO_PORT_PASSERELLE=4000
DOJO_PORT_CHAT=3000
DOJO_PORT_KOKAJI=8100
# L'adresse du chat, telle que le QG y renvoie et que les invitations la portent.
KOKAJI_CHAT_URL=http://localhost:3000
KOKAJI_BASE=http://localhost:8100

# Pour publier : `docker compose --profile web up -d`, un vrai domaine par
# surface — Caddy obtient ses certificats tout seul — et DOJO_BIND=0.0.0.0.
DOJO_HOTE_CHAT=chat.localhost
DOJO_HOTE_KOKAJI=kokaji.localhost
DOJO_BIND=127.0.0.1

# Les dépôts nus des harness (RFC-012) : d'où l'on clone depuis son poste, où
# le scellement pousse. Un dossier de la machine, monté dans le conteneur.
KOKAJI_DEPOTS_HOST=./depots
